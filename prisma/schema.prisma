// ============================================
// New Admin Models
// ============================================

model FeatureFlag {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  description    String?
  enabled        Boolean  @default(false)
  rolloutPercent Int      @default(100)
  targetRoles    Json?
  targetUsers    Json?
  environment    String   @default("production")
  metadata       Json?
  createdBy      String
  creator        User     @relation("CreatedFeatureFlags", fields: [createdBy], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([key])
  @@index([enabled])
}

// Study Buddy Matching Algorithm Settings
model StudyBuddySettings {
  id                   String   @id @default(cuid())
  subjectOverlapWeight Int      @default(40)
  timezoneMatchWeight  Int      @default(20)
  goalAlignmentWeight  Int      @default(15)
  studyPaceWeight      Int      @default(15)
  availabilityWeight   Int      @default(10)
  minCompatibility     Int      @default(50)
  maxMatches           Int      @default(10)
  cooldownHours        Int      @default(24)
  isActive             Boolean  @default(true)
  metadata             Json?
  updatedBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

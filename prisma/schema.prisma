generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                     @id @default(cuid())
  email                     String                     @unique
  phone                     String?                    @unique
  passwordHash              String
  name                      String
  firstName                 String?
  lastName                  String?
  role                      UserRole                   @default(LEARNER)
  emailVerified             DateTime?
  phoneVerified             DateTime?
  arabicName                String?
  profileImage              String?
  bio                       String?
  loginDisabled             Boolean                    @default(false)
  passwordResetRequired     Boolean                    @default(false)
  featureFlags              Json?
  age                       String?
  birthDate                 DateTime?
  country                   String?
  avatar                    String?
  interests                 String?
  goals                     String?
  skillLevel                String?
  learningMode              String?
  studyBuddyPreferences     String?
  onboardingCompleted       Boolean                    @default(false)
  stripeCustomerId          String?                    @unique
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  achievements              Achievement[]
  adminAssignments          AdminAssignment[]          @relation("AdminAssigner")
  adminRoleAssignments      AdminAssignment[]          @relation("AdminRoleAssignments")
  adminAuditLogs            AdminAuditLog[]            @relation("AdminAuditLogs")
  reviewedAppeals           Appeal[]                   @relation("AppealReviewer")
  appeals                   Appeal[]                   @relation("UserAppeals")
  assignmentSubmissions     AssignmentSubmission[]
  messageBlockedBy          BlockedUser[]              @relation("MessageBlockedBy")
  messageBlockedUsers       BlockedUser[]              @relation("MessageBlockedUsers")
  certificates              Certificate[]
  channelSubscriptions      ChannelSubscription[]
  initiatedCoWatchSessions  CoWatchSession[]
  cohortMemberships         CohortMember[]
  conversationParticipants  ConversationParticipant[]
  courseInteractions        CourseInteraction[]
  creator                   Creator?
  reviewedDMCA              DMCARequest[]              @relation("DMCAReviewer")
  createdTemplates          EmailTemplate[]            @relation("TemplateCreator")
  enrollments               Enrollment[]
  nominatedContent          FeaturedContent[]          @relation("ContentNominator")
  reviewedContent           FeaturedContent[]          @relation("ContentReviewer")
  reviewedChannels          FlaggedChannel[]           @relation("ChannelReviewer")
  createdGroups             Group[]
  createdChannels           GroupChannel[]
  groupInvites              GroupMember[]              @relation("GroupInvites")
  groupMemberships          GroupMember[]
  guardianLinks             GuardianLink[]
  following                 InstructorFollow[]         @relation("UserFollowing")
  leaderboardEntries        LeaderboardEntry[]
  lessonProgress            LessonProgress[]
  studentMeetings           Meeting[]                  @relation("StudentMeetings")
  mentorSubscriptions       MentorSubscription[]       @relation("StudentMentorSubscriptions")
  sentMessages              Message[]
  messageReactions          MessageReaction[]
  receivedMessageRequests   MessageRequest[]           @relation("ReceivedMessageRequests")
  sentMessageRequests       MessageRequest[]           @relation("SentMessageRequests")
  moderationEvents          ModerationEvent[]
  notifications             Notification[]
  notificationSettings      NotificationSetting?
  onboardingProgress        OnboardingProgress?
  paymentLinks              PaymentLink[]              @relation("UserPaymentLinks")
  paymentTransactions       PaymentTransaction[]
  peerReviews               PeerReview[]
  playlistItems             PlaylistItem[]
  pollVotes                 PollVote[]
  postBookmarks             PostBookmark[]             @relation("PostBookmarks")
  postComments              PostComment[]              @relation("PostComments")
  projectSubmissions        ProjectSubmission[]
  quizAttempts              QuizAttempt[]
  reports                   Report[]
  reviews                   Review[]
  rewardWins                RewardWinner[]
  scholarshipApps           ScholarshipApplication[]   @relation("ScholarshipApplicant")
  reviewedScholarships      ScholarshipApplication[]   @relation("ScholarshipReviewer")
  createdCampaigns          ScholarshipCampaign[]      @relation("CampaignCreator")
  createdFeatureFlags       FeatureFlag[]              @relation("CreatedFeatureFlags")
  sessions                  Session[]
  sessionAttendances        SessionAttendance[]
  sessionAttendees          SessionAttendee[]          @relation("SessionAttendees")
  signatureCourseInvitation SignatureCourseInvitation?
  studyBuddyMatches         StudyBuddyMatch[]          @relation("UserMatches")
  studyBuddyMatches2        StudyBuddyMatch[]          @relation("UserMatches2")
  studyPreferences          StudyPreferences?
  subscriptions             Subscription[]
  assignedTickets           SupportTicket[]            @relation("AssignedTickets")
  supportTickets            SupportTicket[]            @relation("UserTickets")
  supportMessages           SupportTicketMessage[]
  swipesReceived            SwipeAction[]              @relation("SwipesReceived")
  swipesGiven               SwipeAction[]              @relation("SwipesGiven")
  userBadges                UserBadge[]                @relation("UserBadges")
  issuedBans                UserBan[]                  @relation("AdminBans")
  bans                      UserBan[]                  @relation("UserBans")
  blockedByUsers            UserBlock[]                @relation("BlockedByUsers")
  blockedUsers              UserBlock[]                @relation("BlockedUsers")
  verificationLogs          UserVerification[]
  userXP                    UserXP?                    @relation("UserXP")
  videoAnalytics            VideoAnalytics[]
  videoBookmarks            VideoBookmark[]
  hostedVideoSessions       VideoCallSession[]         @relation("HostVideoSessions")
  invitedVideoSessions      VideoCallSession[]         @relation("InviteeVideoSessions")
  videoCallSignals          VideoCallSignal[]          @relation("VideoCallSignals")
  videoComments             VideoComment[]
  videoCommentLikes         VideoCommentLike[]
  videoNotes                VideoNote[]
  videoProgress             VideoProgress[]
  videoReactions            VideoReaction[]
  videoWatchHistory         VideoWatchHistory[]
  createdGoals              WorkspaceGoal[]
  createdNotes              WorkspaceNote[]            @relation("WorkspaceNotesCreated")
  editedNotes               WorkspaceNote[]            @relation("WorkspaceNotesEdited")
  uploadedResources         WorkspaceResource[]
}

model Creator {
  id                     String                   @id @default(cuid())
  userId                 String                   @unique
  kycStatus              KYCStatus                @default(NOT_STARTED)
  nationalId             String?
  nationalIdImage        String?
  selfieImage            String?
  addressProof           String?
  bankAccountIBAN        String?
  bankName               String?
  stripeConnectAccountId String?
  expertise              String?
  teachingGoals          String?
  contractSigned         Boolean                  @default(false)
  contractSignedAt       DateTime?
  totalEarnings          Float                    @default(0)
  totalSubscribers       Int                      @default(0)
  hourlyRate             Float?
  monthlyPrice           Float?
  basicMonthlyPrice      Float?
  basicYearlyPrice       Float?
  premiumMonthlyPrice    Float?
  premiumYearlyPrice     Float?
  vipMonthlyPrice        Float?
  vipYearlyPrice         Float?
  subscriptionBenefits   Json?
  availableForMeetings   Boolean                  @default(true)
  meetingTypes           Json?
  timezone               String?
  languages              String?
  certifications         Json?
  socialLinks            Json?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  communityResources     CommunityResource[]
  courses                Course[]
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analytics              CreatorAnalytics[]
  channels               CreatorChannel[]
  credentials            CreatorCredential[]
  earnings               CreatorEarnings[]
  creatorPayouts         CreatorPayout[]
  flaggedChannels        FlaggedChannel[]         @relation("FlaggedCreator")
  availability           InstructorAvailability[] @relation("CreatorAvailability")
  followers              InstructorFollow[]
  meetings               Meeting[]
  memberMessages         MemberMessage[]
  memberPolls            MemberPoll[]
  payouts                Payout[]
  videoAssets            VideoAsset[]
  videoPlaylists         VideoPlaylist[]
  coachingTokens         CoachingToken[]
  coachingSessions       CoachingSession[]

  @@index([kycStatus])
  @@index([totalSubscribers])
  @@index([kycStatus, totalSubscribers])
}

// 1:1 Coaching Token System
model CoachingToken {
  id          String            @id @default(cuid())
  userId      String
  creatorId   String
  channelId   String?
  tier        String            @default("GOLD")
  tokensTotal Int               @default(1)
  tokensUsed  Int               @default(0)
  purchasedAt DateTime          @default(now())
  expiresAt   DateTime
  status      String            @default("ACTIVE")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  creator     Creator           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  sessions    CoachingSession[]

  @@index([userId])
  @@index([creatorId])
  @@index([status])
  @@index([expiresAt])
}

model CoachingSession {
  id              String                @id @default(cuid())
  tokenId         String
  creatorId       String
  learnerId       String
  title           String?
  titleAr         String?
  description     String?
  scheduledAt     DateTime
  duration        Int                   @default(30)
  status          CoachingSessionStatus @default(SCHEDULED)
  meetingUrl      String?
  meetingProvider String?               @default("internal")
  notes           String?
  feedback        Json?
  rating          Int?
  cancelReason    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  token           CoachingToken         @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  creator         Creator               @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([tokenId])
  @@index([creatorId])
  @@index([learnerId])
  @@index([scheduledAt])
  @@index([status])
}

model CreatorCredential {
  id            String                @id @default(cuid())
  creatorId     String
  type          CreatorCredentialType
  title         String
  titleAr       String?
  institution   String
  institutionAr String?
  description   String?
  descriptionAr String?
  issueDate     DateTime?
  expiryDate    DateTime?
  credentialId  String?
  credentialUrl String?
  documentUrl   String?
  isVerified    Boolean               @default(false)
  verifiedAt    DateTime?
  verifiedBy    String?
  isPublic      Boolean               @default(true)
  sortOrder     Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  creator       Creator               @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([type])
  @@index([isVerified])
}

model Course {
  id                 String                   @id @default(cuid())
  title              String
  titleAr            String?
  titleDe            String?
  description        String
  descriptionAr      String?
  descriptionDe      String?
  thumbnail          String?
  creatorId          String
  contentType        ContentType              @default(SERIES)
  runtime            Int?
  totalSeasons       Int?
  totalEpisodes      Int?
  episodeDuration    Int?
  frequency          String?
  hostName           String?
  releaseYear        Int?
  maturityRating     String?
  genres             String?
  cast               String?
  trailer            String?
  contentCategory    ContentCategory          @default(CATEGORY_A)
  category           String
  categoryAr         String?
  categoryDe         String?
  skillLevel         String
  skillLevelAr       String?
  skillLevelDe       String?
  duration           Int
  language           String
  type               CourseType               @default(LEARNING)
  price              Float?
  syllabus           Json
  status             ContentStatus            @default(DRAFT)
  publishedAt        DateTime?
  totalViews         Int                      @default(0)
  totalEnrollments   Int                      @default(0)
  rating             Float                    @default(0)
  maxStudents        Int?
  enrollmentEndDate  DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  isHidden           Boolean                  @default(false)
  demoVideoUrl       String?
  achievements       Achievement[]
  assignments        Assignment[]
  capstoneProjects   CapstoneProject[]
  certificates       Certificate[]
  cohorts            Cohort[]
  creator            Creator                  @relation(fields: [creatorId], references: [id])
  interactions       CourseInteraction[]
  courseReviews      CourseReview[]
  enrollments        Enrollment[]
  expertQASessions   ExpertQASession[]
  featuredContent    FeaturedContent[]
  leaderboardEntries LeaderboardEntry[]
  lessons            Lesson[]
  projectSubmissions ProjectSubmission[]
  quizzes            Quiz[]
  reviews            Review[]
  rewards            Reward[]
  signatureCohorts   SignatureCourseCohort[]
  signatureProposal  SignatureCourseProposal?
  signatureWorkbook  SignatureCourseWorkbook?
  videoAssets        VideoAsset[]

  @@index([status])
  @@index([totalEnrollments])
  @@index([rating])
  @@index([publishedAt])
  @@index([creatorId])
  @@index([status, totalEnrollments])
  @@index([status, rating])
  @@index([status, publishedAt])
}

model CourseInteraction {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  liked     Boolean?
  inMyList  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([inMyList])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int
  title     String?
  comment   String
  helpful   Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([rating])
  @@index([createdAt])
}

model Lesson {
  id             String           @id @default(cuid())
  courseId       String
  title          String
  titleAr        String?
  titleDe        String?
  description    String?
  descriptionAr  String?
  descriptionDe  String?
  videoUrl       String
  duration       Int
  order          Int
  seasonNumber   Int?
  episodeNumber  Int?
  resources      Json?
  transcript     String?
  transcriptAr   String?
  transcriptDe   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  assignments    Assignment[]
  course         Course           @relation(fields: [courseId], references: [id])
  progress       LessonProgress[]
  quizzes        Quiz[]
  videoAssets    VideoAsset[]
  videoBookmarks VideoBookmark[]
  videoNotes     VideoNote[]
}

model LessonProgress {
  id           String    @id @default(cuid())
  userId       String
  lessonId     String
  completed    Boolean   @default(false)
  completedAt  DateTime?
  lastPosition Int       @default(0)
  watchTime    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lesson       Lesson    @relation(fields: [lessonId], references: [id])
  user         User      @relation(fields: [userId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@index([completed])
}

model VideoNote {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  timestamp Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lessonId])
  @@index([userId, lessonId])
}

model VideoBookmark {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  timestamp Int
  title     String
  createdAt DateTime @default(now())
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lessonId])
  @@index([userId, lessonId])
}

model CreatorChannel {
  id                   String                @id @default(cuid())
  creatorId            String
  name                 String
  nameAr               String?
  nameDe               String?
  description          String
  descriptionAr        String?
  descriptionDe        String?
  coverImage           String?
  tiers                Json
  totalSubscribers     Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  posts                ChannelPost[]
  channelSubscriptions ChannelSubscription[]
  creator              Creator               @relation(fields: [creatorId], references: [id])
  flaggedChannels      FlaggedChannel[]
  liveSessions         LiveSession[]
  memberGroups         MemberGroup[]
  memberMessages       MemberMessage[]
  memberPolls          MemberPoll[]
  membershipTiers      MembershipTier[]
  paymentTransactions  PaymentTransaction[]
  subscriptions        Subscription[]
}

model Subscription {
  id                   String               @id @default(cuid())
  userId               String
  type                 SubscriptionType
  channelId            String?
  pricePerMonth        Float
  status               String
  startDate            DateTime             @default(now())
  endDate              DateTime?
  cancelledAt          DateTime?
  paymentMethodId      String?
  subscriptionId       String?
  billingCycle         String?
  stripeSubscriptionId String?              @unique
  stripeCustomerId     String?
  paymobOrderId        String?              @unique
  paymobTransactionId  String?              @unique
  autoRenew            Boolean              @default(true)
  metadata             String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  paymentTransactions  PaymentTransaction[]
  channel              CreatorChannel?      @relation(fields: [channelId], references: [id])
  user                 User                 @relation(fields: [userId], references: [id])
}

model PaymentTransaction {
  id                  String           @id @default(cuid())
  userId              String
  subscriptionId      String?
  subscriptionType    SubscriptionType
  channelId           String?
  amount              Float
  currency            String           @default("EGP")
  status              PaymentStatus    @default(PENDING)
  merchantOrderId     String           @unique
  paymobOrderId       String           @unique
  paymobPaymentKey    String
  paymobIframeUrl     String?
  paymobTransactionId String?
  paymentMethod       String?
  failureReason       String?
  metadata            Json?
  paidAt              DateTime?
  failedAt            DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  channel             CreatorChannel?  @relation(fields: [channelId], references: [id])
  subscription        Subscription?    @relation(fields: [subscriptionId], references: [id])
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([channelId])
  @@index([status])
}

model StudyBuddyMatch {
  id             String          @id @default(cuid())
  user1Id        String
  user2Id        String
  status         String
  sharedSubjects String?
  sharedGoals    String?
  chatRoomId     String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user1          User            @relation("UserMatches", fields: [user1Id], references: [id])
  user2          User            @relation("UserMatches2", fields: [user2Id], references: [id])
  studySessions  StudySession[]  @relation("StudySessionMatches")
  workspace      StudyWorkspace?

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([status])
}

model SwipeAction {
  id        String    @id @default(cuid())
  swiperId  String
  swipedId  String
  action    String
  matchedAt DateTime?
  createdAt DateTime  @default(now())
  swiped    User      @relation("SwipesReceived", fields: [swipedId], references: [id], onDelete: Cascade)
  swiper    User      @relation("SwipesGiven", fields: [swiperId], references: [id], onDelete: Cascade)

  @@unique([swiperId, swipedId])
  @@index([swiperId])
  @@index([swipedId])
  @@index([action])
  @@index([matchedAt])
}

model StudyPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique
  preferredStudyTimes   String?
  timezone              String?  @default("UTC")
  weeklyAvailability    Json?
  studyDuration         Int?     @default(60)
  communicationStyle    String?
  responseTime          String?
  languagePreference    String?
  learningStyle         String?
  studyEnvironment      String?
  sessionStructure      String?
  subjectExpertise      Json?
  subjectsToLearn       Json?
  skillLevelPreference  String?
  ageRangePreference    String?
  genderPreference      String?
  locationPreference    String?
  studyGoalType         String?
  studyMethodPreference Json?
  progressTracking      Boolean  @default(true)
  groupSizePreference   String?
  sessionFrequency      String?
  reminderPreferences   Json?
  quietHours            Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([communicationStyle])
  @@index([learningStyle])
  @@index([skillLevelPreference])
}

model GuardianLink {
  id               String         @id @default(cuid())
  userId           String
  guardianName     String
  guardianEmail    String
  guardianPhone    String?
  relationship     String?
  status           GuardianStatus @default(PENDING)
  verificationCode String         @unique
  verifiedAt       DateTime?
  expiresAt        DateTime?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model UserVerification {
  id            String             @id @default(cuid())
  userId        String
  type          VerificationType
  status        VerificationStatus @default(PENDING)
  method        String?
  referenceId   String?
  verifiedAt    DateTime?
  expiresAt     DateTime?
  failureReason String?
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([status])
}

model OnboardingProgress {
  id             String    @id @default(cuid())
  userId         String    @unique
  steps          Json
  completed      Boolean   @default(false)
  completedAt    DateTime?
  lastStep       String?
  lastCheckpoint DateTime  @default(now())
  locale         String?   @default("en")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ModerationEvent {
  id         String              @id @default(cuid())
  userId     String
  eventType  ModerationEventType
  severity   ModerationSeverity  @default(LOW)
  status     ModerationStatus    @default(OPEN)
  reason     String?
  source     String?
  metadata   Json?
  createdAt  DateTime            @default(now())
  resolvedAt DateTime?
  resolvedBy String?
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model StudySession {
  id           String                 @id @default(cuid())
  matchId      String
  title        String
  description  String?
  scheduledAt  DateTime
  duration     Int
  status       StudySessionStatus     @default(SCHEDULED)
  meetingLink  String?
  studyTopics  String?
  notes        String?
  createdBy    String
  joinedAt     DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  cancelReason String?
  feedback     Json?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  match        StudyBuddyMatch        @relation("StudySessionMatches", fields: [matchId], references: [id])
  reminders    StudySessionReminder[]
  videoCalls   VideoCallSession[]

  @@index([matchId])
  @@index([scheduledAt])
  @@index([status])
  @@index([createdBy])
}

model StudySessionReminder {
  id           String       @id @default(cuid())
  sessionId    String
  userId       String
  reminderTime DateTime
  reminderType ReminderType
  sent         Boolean      @default(false)
  sentAt       DateTime?
  createdAt    DateTime     @default(now())
  session      StudySession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([userId])
  @@index([reminderTime])
  @@index([sent])
}

model StudyWorkspace {
  id              String              @id @default(cuid())
  matchId         String              @unique
  name            String
  description     String?
  coverImage      String?
  isActive        Boolean             @default(true)
  settings        Json?
  lastActivityAt  DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  coWatchSessions CoWatchSession[]
  match           StudyBuddyMatch     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  goals           WorkspaceGoal[]
  notes           WorkspaceNote[]
  resources       WorkspaceResource[]

  @@index([matchId])
  @@index([isActive])
  @@index([lastActivityAt])
}

model WorkspaceResource {
  id            String         @id @default(cuid())
  workspaceId   String
  uploadedBy    String
  title         String
  description   String?
  type          ResourceType
  url           String
  fileSize      Int?
  mimeType      String?
  isPinned      Boolean        @default(false)
  tags          String?
  viewCount     Int            @default(0)
  downloadCount Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  uploader      User           @relation(fields: [uploadedBy], references: [id])
  workspace     StudyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([uploadedBy])
  @@index([type])
  @@index([isPinned])
  @@index([createdAt])
}

model WorkspaceNote {
  id           String         @id @default(cuid())
  workspaceId  String
  createdBy    String
  title        String
  content      String

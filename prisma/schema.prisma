generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  phone                 String?   @unique
  passwordHash          String
  name                  String
  role                  UserRole  @default(LEARNER)
  emailVerified         DateTime?
  phoneVerified         DateTime?
  arabicName            String?
  profileImage          String?
  bio                   String?
  interests             String?
  goals                 String?
  skillLevel            String?
  learningMode          String?
  studyBuddyPreferences String?
  onboardingCompleted   Boolean   @default(false)
  stripeCustomerId      String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Existing relationships
  creator               Creator?
  enrollments           Enrollment[]
  sessions              Session[]
  studyBuddyMatches     StudyBuddyMatch[]      @relation("UserMatches")
  studyBuddyMatches2    StudyBuddyMatch[]      @relation("UserMatches2")
  subscriptions         Subscription[]
  videoProgress         VideoProgress[]
  videoAnalytics        VideoAnalytics[]
  playlistItems         PlaylistItem[]
  lessonProgress        LessonProgress[]
  quizAttempts          QuizAttempt[]
  assignmentSubmissions AssignmentSubmission[]
  reviews               Review[]
  following             InstructorFollow[]     @relation("UserFollowing")
  studentMeetings       Meeting[]              @relation("StudentMeetings")
  mentorSubscriptions   MentorSubscription[]   @relation("StudentMentorSubscriptions")

  // Messaging system relationships
  sentMessages             Message[]
  conversationParticipants ConversationParticipant[]
  messageReactions         MessageReaction[]
  createdGroups            Group[]
  groupMemberships         GroupMember[]
  groupInvites             GroupMember[]             @relation("GroupInvites")
  createdChannels          GroupChannel[]
  notifications            Notification[]
  notificationSettings     NotificationSetting?
  studyPreferences         StudyPreferences?

  // Video Call Relations
  hostedVideoSessions  VideoCallSession[] @relation("HostVideoSessions")
  invitedVideoSessions VideoCallSession[] @relation("InviteeVideoSessions")
  videoCallSignals     VideoCallSignal[]  @relation("VideoCallSignals")

  // Certificates
  certificates Certificate[]

  // Study Buddy Swipe Actions
  swipesGiven    SwipeAction[] @relation("SwipesGiven")
  swipesReceived SwipeAction[] @relation("SwipesReceived")

  // Study Workspace Relations
  uploadedResources        WorkspaceResource[]
  createdNotes             WorkspaceNote[]     @relation("WorkspaceNotesCreated")
  editedNotes              WorkspaceNote[]     @relation("WorkspaceNotesEdited")
  createdGoals             WorkspaceGoal[]
  initiatedCoWatchSessions CoWatchSession[]

  // Rewards & Leaderboards Relations
  leaderboardEntries LeaderboardEntry[]
  achievements       Achievement[]
  rewardWins         RewardWinner[]
  projectSubmissions ProjectSubmission[]
  peerReviews        PeerReview[]

  // Netflix-style interactions
  courseInteractions CourseInteraction[]

  // Signature Course Relations
  signatureCourseInvitation SignatureCourseInvitation?

  // Blocking and Reporting
  blockedUsers   UserBlock[] @relation("BlockedUsers")
  blockedByUsers UserBlock[] @relation("BlockedByUsers")
  reports        Report[]

  // Video Player Relations
  videoNotes     VideoNote[]
  videoBookmarks VideoBookmark[]

  // Video Streaming Relations
  videoComments     VideoComment[]
  videoCommentLikes VideoCommentLike[]
  videoWatchHistory VideoWatchHistory[]
  videoReactions    VideoReaction[]

  // Gamification Relations
  userXP     UserXP?     @relation("UserXP")
  userBadges UserBadge[] @relation("UserBadges")

  // Membership Channel Relations
  channelSubscriptions ChannelSubscription[]
  pollVotes            PollVote[]

  // Post Relations
  postComments  PostComment[]  @relation("PostComments")
  postBookmarks PostBookmark[] @relation("PostBookmarks")

  // Cohort-Based Learning
  cohortMemberships  CohortMember[]
  sessionAttendances SessionAttendance[]
}

model Creator {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  kycStatus              KYCStatus @default(NOT_STARTED)
  nationalId             String?
  nationalIdImage        String?
  selfieImage            String?
  addressProof           String?
  bankAccountIBAN        String?
  bankName               String?
  stripeConnectAccountId String? // Stripe Connect account for payouts
  expertise              String?
  teachingGoals          String?
  contractSigned         Boolean   @default(false)
  contractSignedAt       DateTime?
  totalEarnings          Float     @default(0)
  totalSubscribers       Int       @default(0)
  hourlyRate             Float? // Hourly rate for consultations (legacy)

  // Mentor Subscription Pricing (OnlyFans-style)
  basicMonthlyPrice   Float? // Basic tier monthly price
  basicYearlyPrice    Float? // Basic tier yearly price
  premiumMonthlyPrice Float? // Premium tier monthly price
  premiumYearlyPrice  Float? // Premium tier yearly price
  vipMonthlyPrice     Float? // VIP tier monthly price
  vipYearlyPrice      Float? // VIP tier yearly price

  // What each tier includes
  subscriptionBenefits Json? // Define benefits for each tier

  availableForMeetings Boolean                  @default(true)
  meetingTypes         Json? // Available meeting types and durations
  timezone             String? // Creator's timezone
  languages            String? // Languages spoken
  certifications       Json? // Array of certifications
  socialLinks          Json? // Social media links
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  courses              Course[]
  user                 User                     @relation(fields: [userId], references: [id])
  channels             CreatorChannel[]
  payouts              Payout[]
  videoAssets          VideoAsset[]
  followers            InstructorFollow[]
  meetings             Meeting[]
  availability         InstructorAvailability[] @relation("CreatorAvailability")

  // New blueprint relationships
  earnings       CreatorEarnings[]
  creatorPayouts CreatorPayout[]
  analytics      CreatorAnalytics[]

  // Membership Tools Relations
  memberMessages MemberMessage[]
  memberPolls    MemberPoll[]

  // Video Streaming Relations
  videoPlaylists VideoPlaylist[]

  // Withdrawal Relations
  withdrawals Withdrawal[]

  // Community Resources
  communityResources CommunityResource[]

  // Essential performance indexes for Creator
  @@index([kycStatus])
  @@index([totalSubscribers])
  @@index([kycStatus, totalSubscribers])
}

model Course {
  id            String  @id @default(cuid())
  title         String
  titleAr       String?
  titleDe       String?
  description   String
  descriptionAr String?
  descriptionDe String?
  thumbnail     String?
  creatorId     String

  // Netflix-style Content Type
  contentType ContentType @default(SERIES)

  // Movie-specific fields
  runtime Int? // Runtime in minutes (for movies)

  // Series-specific fields
  totalSeasons    Int? // Number of seasons
  totalEpisodes   Int? // Total episode count
  episodeDuration Int? // Average episode duration

  // Podcast-specific fields
  frequency String? // e.g., "Weekly", "Daily", "Monthly"
  hostName  String? // Podcast host name

  // Common fields
  releaseYear    Int? // Release year
  maturityRating String? // e.g., "PG", "PG-13", "R", "18+"
  genres         String? // JSON array of genres
  cast           String? // JSON array of cast/instructors
  trailer        String? // Trailer/preview URL

  // Content Category - determines access model
  contentCategory ContentCategory @default(CATEGORY_A)

  // Subject categorization
  category     String
  categoryAr   String?
  categoryDe   String?
  skillLevel   String
  skillLevelAr String?
  skillLevelDe String?
  duration     Int
  language     String

  // Human-friendly course "type" used for UI filtering (Kids, Amusement, Learning, Podcasts, Music, Business)
  type CourseType @default(LEARNING)

  // Price is NULL for Category A (subscription-only)
  // Price can be set for Category B if sold separately (optional)
  price Float?

  syllabus         Json
  status           ContentStatus @default(DRAFT)
  publishedAt      DateTime?
  totalViews       Int           @default(0)
  totalEnrollments Int           @default(0)
  rating           Float         @default(0)

  // Enrollment Settings
  maxStudents       Int? // Maximum number of students (null = unlimited)
  enrollmentEndDate DateTime? // Auto-close enrollment after this date (null = always open)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  demoVideoUrl  String?
  creator       Creator        @relation(fields: [creatorId], references: [id])
  enrollments   Enrollment[]
  lessons       Lesson[]
  videoAssets   VideoAsset[]
  quizzes       Quiz[]
  assignments   Assignment[]
  reviews       Review[]
  courseReviews CourseReview[] // Admin content review
  certificates  Certificate[]

  // Rewards & Leaderboards Relations
  leaderboardEntries LeaderboardEntry[]
  achievements       Achievement[]
  rewards            Reward[]
  projectSubmissions ProjectSubmission[]

  // Netflix-style interactions
  interactions CourseInteraction[]

  // Signature Course Relations
  signatureProposal SignatureCourseProposal?
  signatureWorkbook SignatureCourseWorkbook?
  signatureCohorts  SignatureCourseCohort[]
  expertQASessions  ExpertQASession[]
  capstoneProjects  CapstoneProject[]

  // Cohort-Based Learning
  cohorts Cohort[]

  // Essential performance indexes
  @@index([status])
  @@index([totalEnrollments])
  @@index([rating])
  @@index([publishedAt])
  @@index([creatorId])
  @@index([status, totalEnrollments])
  @@index([status, rating])
  @@index([status, publishedAt])
}

// Netflix-style Course Interactions (Like/Dislike/MyList)
model CourseInteraction {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  liked     Boolean? // true = thumbs up, false = thumbs down, null = not rated
  inMyList  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([inMyList])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int // 1-5 star rating
  title     String? // Optional review title
  comment   String // Review text
  helpful   Int      @default(0) // Number of helpful votes
  verified  Boolean  @default(false) // Verified purchase/enrollment
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId]) // One review per user per course
  @@index([courseId])
  @@index([rating])
  @@index([createdAt])
}

model Lesson {
  id            String  @id @default(cuid())
  courseId      String
  title         String
  titleAr       String?
  titleDe       String?
  description   String?
  descriptionAr String?
  descriptionDe String?
  videoUrl      String
  duration      Int
  order         Int

  // Series-specific fields
  seasonNumber  Int? // Season number (for series)
  episodeNumber Int? // Episode number within season

  resources      Json?
  transcript     String?
  transcriptAr   String?
  transcriptDe   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  course         Course           @relation(fields: [courseId], references: [id])
  videoAssets    VideoAsset[]
  progress       LessonProgress[]
  quizzes        Quiz[]
  assignments    Assignment[]
  videoNotes     VideoNote[]
  videoBookmarks VideoBookmark[]
}

model LessonProgress {
  id           String    @id @default(cuid())
  userId       String
  lessonId     String
  completed    Boolean   @default(false)
  completedAt  DateTime?
  lastPosition Int       @default(0) // Last watched position in seconds
  watchTime    Int       @default(0) // Total watch time in seconds
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id])
  lesson       Lesson    @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@index([completed])
}

model VideoNote {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  timestamp Int // Timestamp in seconds where note was taken
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lessonId])
  @@index([userId, lessonId])
}

model VideoBookmark {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  timestamp Int // Timestamp in seconds
  title     String // User-defined bookmark title
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lessonId])
  @@index([userId, lessonId])
}

model CreatorChannel {
  id               String   @id @default(cuid())
  creatorId        String
  name             String
  nameAr           String?
  nameDe           String?
  description      String
  descriptionAr    String?
  descriptionDe    String?
  coverImage       String?
  tiers            Json
  totalSubscribers Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  creator       Creator        @relation(fields: [creatorId], references: [id])
  subscriptions Subscription[]

  // New blueprint relationships
  posts        ChannelPost[]
  liveSessions LiveSession[]
  memberGroups MemberGroup[]

  // Membership Tools Relations
  membershipTiers      MembershipTier[]
  channelSubscriptions ChannelSubscription[]
  memberMessages       MemberMessage[]
  memberPolls          MemberPoll[]
}

// Old ChannelPost model - will be removed, using new one from blueprint
// model ChannelPost {
//   id        String         @id @default(cuid())
//   channelId String
//   content   String
//   contentAr String?
//   contentDe String?

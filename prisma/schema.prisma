//   mediaType String?
//   createdAt DateTime       @default(now())
//   updatedAt DateTime       @updatedAt
//   channel   CreatorChannel @relation(fields: [channelId], references: [id])
// }

model Subscription {
  id                   String           @id @default(cuid())
  userId               String
  type                 SubscriptionType
  channelId            String?
  pricePerMonth        Float
  status               String
  startDate            DateTime         @default(now())
  endDate              DateTime?
  cancelledAt          DateTime?
  paymentMethodId      String?
  subscriptionId       String?
  billingCycle         String? // 'monthly' or 'yearly'
  stripeSubscriptionId String?          @unique
  stripeCustomerId     String?
  metadata             String? // JSON string for storing additional data like creatorId, tier, etc.
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  channel              CreatorChannel?  @relation(fields: [channelId], references: [id])
  user                 User             @relation(fields: [userId], references: [id])
}

model StudyBuddyMatch {
  id             String   @id @default(cuid())
  user1Id        String
  user2Id        String
  status         String
  sharedSubjects String?
  sharedGoals    String?
  chatRoomId     String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user1          User     @relation("UserMatches", fields: [user1Id], references: [id])
  user2          User     @relation("UserMatches2", fields: [user2Id], references: [id])

  // Study sessions relationship
  studySessions StudySession[] @relation("StudySessionMatches")

  // Study workspace relationship
  workspace StudyWorkspace?

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([status])
}

// Swipe Actions for Study Buddy Matching
model SwipeAction {
  id        String    @id @default(cuid())
  swiperId  String // User who performed the swipe
  swipedId  String // User who was swiped on
  action    String // "LIKE" or "PASS"
  matchedAt DateTime? // Set when mutual like creates a match
  createdAt DateTime  @default(now())

  swiper User @relation("SwipesGiven", fields: [swiperId], references: [id], onDelete: Cascade)
  swiped User @relation("SwipesReceived", fields: [swipedId], references: [id], onDelete: Cascade)

  @@unique([swiperId, swipedId])
  @@index([swiperId])
  @@index([swipedId])
  @@index([action])
  @@index([matchedAt])
}

// Study Preferences Management
model StudyPreferences {
  id     String @id @default(cuid())
  userId String @unique

  // Study Time Preferences
  preferredStudyTimes String? // JSON array of time slots
  timezone            String? @default("UTC")
  weeklyAvailability  Json? // Weekly schedule availability
  studyDuration       Int?    @default(60) // Preferred session duration in minutes

  // Communication Preferences  
  communicationStyle String? // "text", "voice", "video", "mixed"
  responseTime       String? // "immediate", "within_hour", "within_day", "flexible"
  languagePreference String? // "arabic", "english", "both"

  // Learning Style Preferences
  learningStyle    String? // "visual", "auditory", "kinesthetic", "reading"
  studyEnvironment String? // "quiet", "background_music", "collaborative", "flexible"
  sessionStructure String? // "structured", "flexible", "discussion_based", "problem_solving"

  // Subject and Skill Preferences
  subjectExpertise     Json? // Areas where user can help others
  subjectsToLearn      Json? // Areas where user wants help
  skillLevelPreference String? // "beginner", "intermediate", "advanced", "mixed"

  // Compatibility Preferences
  ageRangePreference String? // "18-25", "26-35", "36-45", "any"
  genderPreference   String? // "any", "same", "different"
  locationPreference String? // "same_city", "same_country", "any"

  // Study Goals and Methods
  studyGoalType         String? // "exam_prep", "skill_building", "project_work", "general_learning"
  studyMethodPreference Json? // Preferred study methods
  progressTracking      Boolean @default(true)

  // Session Preferences
  groupSizePreference String? // "one_on_one", "small_group", "large_group", "flexible"
  sessionFrequency    String? // "daily", "weekly", "bi_weekly", "monthly", "flexible"

  // Notifications and Reminders
  reminderPreferences Json? // When to receive reminders
  quietHours          Json? // When not to receive notifications

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([communicationStyle])
  @@index([learningStyle])
  @@index([skillLevelPreference])
}

// Study Session Management
model StudySession {
  id           String             @id @default(cuid())
  matchId      String
  title        String
  description  String?
  scheduledAt  DateTime
  duration     Int // in minutes
  status       StudySessionStatus @default(SCHEDULED)
  meetingLink  String? // For video calls
  studyTopics  String? // JSON array of topics
  notes        String? // Session notes
  createdBy    String
  joinedAt     DateTime? // When both users joined
  startedAt    DateTime? // Actual start time
  completedAt  DateTime? // Actual completion time
  cancelReason String?
  feedback     Json? // Post-session feedback
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  match      StudyBuddyMatch        @relation("StudySessionMatches", fields: [matchId], references: [id])
  reminders  StudySessionReminder[]
  videoCalls VideoCallSession[] // Video calls for this session

  @@index([matchId])
  @@index([scheduledAt])
  @@index([status])
  @@index([createdBy])
}

model StudySessionReminder {
  id           String       @id @default(cuid())
  sessionId    String
  userId       String
  reminderTime DateTime // When to send the reminder
  reminderType ReminderType
  sent         Boolean      @default(false)
  sentAt       DateTime?
  createdAt    DateTime     @default(now())

  session StudySession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([userId])
  @@index([reminderTime])
  @@index([sent])
}

// Study Buddy Shared Workspace
model StudyWorkspace {
  id             String   @id @default(cuid())
  matchId        String   @unique
  name           String // Custom workspace name
  description    String?
  coverImage     String?
  isActive       Boolean  @default(true)
  settings       Json? // Workspace settings (notifications, privacy, etc.)
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  match           StudyBuddyMatch     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  resources       WorkspaceResource[]
  notes           WorkspaceNote[]
  goals           WorkspaceGoal[]
  coWatchSessions CoWatchSession[]

  @@index([matchId])
  @@index([isActive])
  @@index([lastActivityAt])
}

// Shared Resources (PDFs, links, videos, etc.)
model WorkspaceResource {
  id            String       @id @default(cuid())
  workspaceId   String
  uploadedBy    String // User ID who uploaded
  title         String
  description   String?
  type          ResourceType // "pdf", "link", "video", "image", "document"
  url           String // File URL or external link
  fileSize      Int? // In bytes
  mimeType      String?
  isPinned      Boolean      @default(false)
  tags          String? // JSON array of tags
  viewCount     Int          @default(0)
  downloadCount Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  workspace StudyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploader  User           @relation(fields: [uploadedBy], references: [id])

  @@index([workspaceId])
  @@index([uploadedBy])
  @@index([type])
  @@index([isPinned])
  @@index([createdAt])
}

// Shared Notes (Collaborative notes)
model WorkspaceNote {
  id           String    @id @default(cuid())
  workspaceId  String
  createdBy    String // User ID who created
  title        String
  content      String // Rich text content
  color        String?   @default("#fbbf24") // Note color
  isPinned     Boolean   @default(false)
  tags         String? // JSON array of tags
  lastEditedBy String? // Last user who edited
  lastEditedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace  StudyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator    User           @relation("WorkspaceNotesCreated", fields: [createdBy], references: [id])
  lastEditor User?          @relation("WorkspaceNotesEdited", fields: [lastEditedBy], references: [id])

  @@index([workspaceId])
  @@index([createdBy])
  @@index([isPinned])
  @@index([createdAt])
}

// Shared Goals & Progress Tracking
model WorkspaceGoal {
  id          String     @id @default(cuid())
  workspaceId String
  createdBy   String
  title       String
  description String?
  targetDate  DateTime?
  status      GoalStatus @default(IN_PROGRESS)
  progress    Int        @default(0) // 0-100
  category    String? // "learning", "project", "exam", "skill"
  priority    String?    @default("medium") // "low", "medium", "high"
  milestones  Json? // Array of milestone objects
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace StudyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User           @relation(fields: [createdBy], references: [id])

  @@index([workspaceId])
  @@index([createdBy])
  @@index([status])
  @@index([targetDate])
}

// Co-Watch Sessions (Watch videos together)
model CoWatchSession {
  id             String        @id @default(cuid())
  workspaceId    String
  initiatedBy    String // User who started
  videoUrl       String // Course lesson or external video URL
  videoTitle     String
  videoThumbnail String?
  currentTime    Float         @default(0) // Current playback position in seconds
  duration       Float? // Total video duration
  isPlaying      Boolean       @default(false)
  status         CoWatchStatus @default(ACTIVE)
  startedAt      DateTime      @default(now())
  endedAt        DateTime?
  participants   Json? // Array of participant user IDs and join times
  chatMessages   Json? // Simplified chat messages array
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace StudyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  initiator User           @relation(fields: [initiatedBy], references: [id])

  @@index([workspaceId])
  @@index([initiatedBy])
  @@index([status])
  @@index([isPlaying])
}

enum ResourceType {
  PDF
  LINK
  VIDEO
  AUDIO
  IMAGE
  DOCUMENT
  SPREADSHEET
  PRESENTATION
  WORKBOOK
  TEMPLATE
  OTHER
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PAUSED
  CANCELLED
}

enum CoWatchStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum StudySessionStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReminderType {
  ONE_HOUR_BEFORE
  THIRTY_MINUTES_BEFORE
  FIFTEEN_MINUTES_BEFORE
  SESSION_START
}

model Enrollment {
  id               String       @id @default(cuid())
  userId           String
  courseId         String
  progress         Float        @default(0)
  completedLessons String?
  lastAccessedAt   DateTime?
  completedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  course           Course       @relation(fields: [courseId], references: [id])
  user             User         @relation(fields: [userId], references: [id])
  certificate      Certificate?

  @@unique([userId, courseId])
}

model Certificate {
  id                String    @id @default(cuid())
  enrollmentId      String    @unique
  userId            String
  courseId          String
  certificateNumber String    @unique
  issueDate         DateTime  @default(now())
  completionDate    DateTime
  grade             String? // e.g., "A+", "Excellent", "95%"
  credentialUrl     String? // Verifiable credential URL
  sharedOn          String? // JSON array of platforms shared to (LinkedIn, Twitter, etc.)
  downloadCount     Int       @default(0)
  lastDownloadedAt  DateTime?
  isPublic          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])
  course     Course     @relation(fields: [courseId], references: [id])
}

// Rewards & Leaderboards System

// Course Leaderboard Entries
model LeaderboardEntry {
  id                 String   @id @default(cuid())
  userId             String
  courseId           String
  totalScore         Float    @default(0) // Total points earned
  quizScore          Float    @default(0) // Points from quizzes
  projectScore       Float    @default(0) // Points from projects
  participationScore Float    @default(0) // Points from participation
  rank               Int? // Current rank (calculated)
  lastUpdated        DateTime @default(now())
  createdAt          DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, totalScore])
  @@index([userId])
}

// Achievements/Badges
model Achievement {
  id            String          @id @default(cuid())
  userId        String
  type          AchievementType
  title         String
  titleAr       String?
  description   String
  descriptionAr String?
  icon          String? // Icon/badge image
  points        Int             @default(0) // Points awarded
  courseId      String? // Course-specific achievement
  unlockedAt    DateTime        @default(now())
  createdAt     DateTime        @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([courseId])
}

// XP (Experience Points) Tracking
model UserXP {
  id             String   @id @default(cuid())
  userId         String   @unique
  totalXP        Int      @default(0)
  currentLevel   Int      @default(1)
  xpToNextLevel  Int      @default(100)
  lifetimeXP     Int      @default(0) // Total XP earned ever
  currentStreak  Int      @default(0) // Current daily login streak
  longestStreak  Int      @default(0) // Longest streak achieved
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User            @relation("UserXP", fields: [userId], references: [id], onDelete: Cascade)
  transactions XPTransaction[]

  @@index([totalXP])
  @@index([currentLevel])
}

// XP Transactions (history of XP gains/losses)
model XPTransaction {
  id                String            @id @default(cuid())
  userId            String
  userXPId          String
  amount            Int // Positive for gains, negative for losses
  reason            String // e.g., "Completed lesson", "Daily login"
  type              XPTransactionType
  relatedEntityId   String? // Course ID, Lesson ID, etc.
  relatedEntityType String? // "Course", "Lesson", "Quiz", etc.
  createdAt         DateTime          @default(now())

  userXP UserXP @relation(fields: [userXPId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userXPId])
  @@index([type])
  @@index([createdAt])
}

// Badge Definitions (template for badges)
model BadgeDefinition {
  id            String        @id @default(cuid())
  code          String        @unique // Unique code like "FIRST_COURSE"
  title         String
  titleAr       String?
  description   String
  descriptionAr String?
  icon          String // Icon name or URL
  color         String        @default("#8B5CF6") // Badge color
  rarity        BadgeRarity   @default(COMMON)
  xpReward      Int           @default(0) // XP earned when badge is unlocked
  category      BadgeCategory @default(LEARNING)
  isActive      Boolean       @default(true)
  requirements  String // JSON: conditions to earn
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  earnedBadges UserBadge[]

  @@index([code])
  @@index([category])
  @@index([rarity])
}

// User Earned Badges
model UserBadge {
  id         String    @id @default(cuid())
  userId     String
  badgeDefId String
  progress   Float     @default(0) // Progress towards earning (0-100)
  isEarned   Boolean   @default(false)
  earnedAt   DateTime?
  createdAt  DateTime  @default(now())

  user            User            @relation("UserBadges", fields: [userId], references: [id], onDelete: Cascade)
  badgeDefinition BadgeDefinition @relation(fields: [badgeDefId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeDefId])
  @@index([userId])
  @@index([badgeDefId])
  @@index([isEarned])
}

// Rewards (Scholarships, Prizes, Certificates)
model Reward {
  id            String     @id @default(cuid())
  title         String
  titleAr       String?
  description   String
  descriptionAr String?
  type          RewardType
  value         Float? // Monetary value (for scholarships)
  currency      String?    @default("EGP")
  courseId      String? // Course-specific reward
  requirements  String // JSON: requirements to earn
  maxWinners    Int? // Max number of winners
  startDate     DateTime?
  endDate       DateTime?
  isActive      Boolean    @default(true)
  imageUrl      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  course  Course?        @relation(fields: [courseId], references: [id])
  winners RewardWinner[]

  @@index([courseId])
  @@index([isActive])
  @@index([endDate])
}

// Reward Winners
model RewardWinner {
  id        String       @id @default(cuid())
  rewardId  String
  userId    String
  rank      Int? // If ranked reward (1st, 2nd, 3rd)
  awardedAt DateTime     @default(now())
  claimedAt DateTime?
  status    RewardStatus @default(PENDING)
  notes     String?

  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rewardId, userId])
  @@index([userId])
  @@index([status])
}

// Project Submissions (for tracking)
model ProjectSubmission {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  projectId   String // Reference to project/assignment
  title       String
  description String?
  fileUrls    String? // JSON array of file URLs
  submittedAt DateTime         @default(now())
  grade       Float?
  maxGrade    Float?
  feedback    String?
  status      SubmissionStatus @default(SUBMITTED)
  reviewedAt  DateTime?
  reviewedBy  String? // Instructor user ID

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId, courseId])
  @@index([projectId])
  @@index([status])
}

// Peer Reviews
model PeerReview {
  id           String   @id @default(cuid())
  submissionId String // ProjectSubmission ID
  reviewerId   String // User who is reviewing
  rating       Float // 1-5 stars
  feedback     String?
  isHelpful    Boolean  @default(false)
  createdAt    DateTime @default(now())

  reviewer User @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([reviewerId])
}

enum AchievementType {
  FIRST_COURSE_COMPLETED
  QUIZ_MASTER
  PERFECT_SCORE
  FAST_LEARNER
  CONSISTENT_LEARNER
  TOP_PERFORMER
  PEER_REVIEWER
  COMMUNITY_HELPER
  CERTIFICATE_EARNED
  STREAK_MILESTONE
}

enum RewardType {
  SCHOLARSHIP
  PRIZE
  DISCOUNT
  CERTIFICATE
  BADGE
  COURSE_ACCESS
}

enum RewardStatus {
  PENDING
  CLAIMED
  EXPIRED
  CANCELLED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  GRADED
  RETURNED
}

enum XPTransactionType {
  LESSON_COMPLETED
  QUIZ_COMPLETED
  COURSE_COMPLETED
  DAILY_LOGIN
  STREAK_MILESTONE
  ACHIEVEMENT_UNLOCKED
  BADGE_EARNED
  PERFECT_SCORE
  FIRST_COURSE
  REVIEW_SUBMITTED
  QUESTION_ANSWERED
  COMMUNITY_CONTRIBUTION
  BONUS
  PENALTY
}

enum BadgeRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum BadgeCategory {
  LEARNING
  ACHIEVEMENT
  SOCIAL
  STREAK
  MASTERY
  SPECIAL
}

model Payout {
  id             String    @id @default(cuid())
  creatorId      String
  amount         Float
  currency       String    @default("EGP")
  status         String
  bankTransferId String?
  processedAt    DateTime?
  failureReason  String?
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  creator        Creator   @relation(fields: [creatorId], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model VideoAsset {
  id               String           @id @default(cuid())
  muxAssetId       String           @unique
  muxPlaybackId    String?
  uploadId         String?          @unique
  status           VideoStatus      @default(UPLOADING)
  title            String
  titleAr          String?
  titleDe          String?
  description      String?
  descriptionAr    String?
  descriptionDe    String?
  duration         Float?
  aspectRatio      String?
  maxResolution    String?
  frameRate        Float?
  fileSize         Int?
  originalFilename String?
  thumbnailUrl     String?
  creatorId        String
  courseId         String?
  lessonId         String?
  errors           Json?
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  creator          Creator          @relation(fields: [creatorId], references: [id])
  course           Course?          @relation(fields: [courseId], references: [id])
  lesson           Lesson?          @relation(fields: [lessonId], references: [id])
  progress         VideoProgress[]
  analytics        VideoAnalytics[]
  playlistItems    PlaylistItem[]

  // New video streaming relations
  comments         VideoComment[]
  playlistItemsNew VideoPlaylistItem[] @relation("PlaylistItems")
  subtitles        VideoSubtitle[]
  qualities        VideoQuality[]
  watchHistory     VideoWatchHistory[] @relation("WatchHistory")
  reactions        VideoReaction[]
  chapters         VideoChapter[]

  @@index([muxAssetId])
  @@index([creatorId])
  @@index([courseId])
  @@index([status])
}

model VideoProgress {
  id           String     @id @default(cuid())
  userId       String
  videoAssetId String
  currentTime  Float      @default(0)
  duration     Float?
  progress     Float      @default(0)
  completed    Boolean    @default(false)
  lastWatched  DateTime   @default(now())
  deviceInfo   Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id])
  videoAsset   VideoAsset @relation(fields: [videoAssetId], references: [id])

  @@unique([userId, videoAssetId])
  @@index([userId])
  @@index([videoAssetId])
  @@index([completed])
}

model VideoAnalytics {
  id             String     @id @default(cuid())
  videoAssetId   String
  userId         String?
  sessionId      String
  event          String
  timestamp      DateTime   @default(now())
  currentTime    Float?
  duration       Float?
  quality        String?
  buffering      Boolean    @default(false)
  userAgent      String?
  ipAddress      String?
  country        String?
  city           String?
  connectionType String?
  playbackRate   Float?
  volume         Float?
  metadata       Json?
  createdAt      DateTime   @default(now())
  videoAsset     VideoAsset @relation(fields: [videoAssetId], references: [id])
  user           User?      @relation(fields: [userId], references: [id])

  @@index([videoAssetId])
  @@index([userId])
  @@index([event])
  @@index([timestamp])
  @@index([sessionId])
}

model PlaylistItem {
  id           String     @id @default(cuid())
  userId       String
  videoAssetId String
  order        Int
  addedAt      DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id])
  videoAsset   VideoAsset @relation(fields: [videoAssetId], references: [id])

  @@unique([userId, videoAssetId])
  @@index([userId])
  @@index([order])
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  ERROR
  DELETED
}

enum UserRole {
  LEARNER
  CREATOR
  ADMIN
}

enum SubscriptionType {
  CATEGORY_A // All-Access Library only
  CATEGORY_B // Signature Courses only  
  CATEGORY_C // Creator Channel
  BUNDLE_AB // All-Access + Signature bundle
  BUNDLE_ABC // Everything bundle
}

enum KYCStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum ContentStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  REJECTED
}

enum ContentCategory {
  CATEGORY_A // All-Access Library (subscription-based)
  CATEGORY_B // Signature Courses (curated, subscription-based)
  CATEGORY_C // Creator Channel content (creator subscription)
}

enum ContentType {
  MOVIE // Single video content (like a documentary or single course)
  SERIES // Multiple episodes/lessons
  PODCAST // Audio-first content
}

// High-level course types used for client-side filtering (Kids/Learning/Business/etc.)
enum CourseType {
  KIDS
  AMUSEMENT
  LEARNING
  PODCASTS
  MUSIC
  BUSINESS
  OTHER
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
}

enum AssignmentType {
  QUIZ
  PROJECT
  ESSAY
  PRACTICAL
}

model Quiz {
  id               String        @id @default(cuid())
  courseId         String
  lessonId         String?
  title            String
  titleAr          String?
  titleDe          String?
  description      String?
  descriptionAr    String?
  descriptionDe    String?
  timeLimit        Int? // in minutes
  passingScore     Float         @default(70)
  maxAttempts      Int           @default(3)
  shuffleQuestions Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  course           Course        @relation(fields: [courseId], references: [id])
  lesson           Lesson?       @relation(fields: [lessonId], references: [id])
  questions        Question[]
  attempts         QuizAttempt[]

  @@index([courseId])
  @@index([lessonId])
}

model Question {
  id            String       @id @default(cuid())
  quizId        String
  type          QuestionType
  question      String
  questionAr    String?
  questionDe    String?
  options       Json? // Array of options for multiple choice
  correctAnswer String
  explanation   String?
  explanationAr String?
  explanationDe String?
  points        Float        @default(1)
  order         Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  quiz          Quiz         @relation(fields: [quizId], references: [id])
  answers       QuizAnswer[]

  @@index([quizId])
}

model QuizAttempt {
  id          String       @id @default(cuid())
  quizId      String
  userId      String
  score       Float
  maxScore    Float
  passed      Boolean      @default(false)
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  timeSpent   Int? // in seconds
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  quiz        Quiz         @relation(fields: [quizId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  answers     QuizAnswer[]

  @@unique([quizId, userId])
  @@index([userId])
  @@index([quizId])
}

model QuizAnswer {
  id         String      @id @default(cuid())
  attemptId  String
  questionId String
  answer     String
  isCorrect  Boolean
  points     Float       @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id])
  question   Question    @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model Assignment {
  id                  String                 @id @default(cuid())
  courseId            String
  lessonId            String?
  type                AssignmentType
  title               String
  titleAr             String?
  titleDe             String?
  description         String
  descriptionAr       String?
  descriptionDe       String?
  instructions        String?
  instructionsAr      String?
  instructionsDe      String?
  dueDate             DateTime?
  maxPoints           Float                  @default(100)
  allowLateSubmission Boolean                @default(false)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  course              Course                 @relation(fields: [courseId], references: [id])
  lesson              Lesson?                @relation(fields: [lessonId], references: [id])
  submissions         AssignmentSubmission[]

  @@index([courseId])
  @@index([lessonId])
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  userId       String
  content      String
  fileUrls     Json? // Array of file URLs
  score        Float?
  feedback     String?
  submittedAt  DateTime   @default(now())
  gradedAt     DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@unique([assignmentId, userId])
  @@index([userId])
  @@index([assignmentId])
}

// Messaging System Models

model Conversation {
  id          String           @id @default(cuid())
  type        ConversationType
  title       String?
  description String?
  avatar      String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relationships
  participants ConversationParticipant[]
  messages     Message[]
  groups       Group?

  @@index([type])
  @@index([updatedAt])
}

model ConversationParticipant {
  id             String          @id @default(cuid())
  conversationId String
  userId         String
  role           ParticipantRole @default(MEMBER)
  joinedAt       DateTime        @default(now())
  lastReadAt     DateTime?
  isActive       Boolean         @default(true)
  isArchived     Boolean         @default(false)
  isMuted        Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@index([lastReadAt])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  messageType    MessageType @default(TEXT)
  replyToId      String?
  edited         Boolean     @default(false)
  editedAt       DateTime?
  isDeleted      Boolean     @default(false)
  isPinned       Boolean     @default(false)
  isStarred      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relationships
  conversation Conversation        @relation(fields: [conversationId], references: [id])
  sender       User                @relation(fields: [senderId], references: [id])
  replyTo      Message?            @relation("MessageReplies", fields: [replyToId], references: [id])
  replies      Message[]           @relation("MessageReplies")
  attachments  MessageAttachment[]
  reactions    MessageReaction[]

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model MessageAttachment {
  id           String   @id @default(cuid())
  messageId    String
  fileName     String
  fileSize     Int
  fileType     String
  fileUrl      String
  thumbnailUrl String?
  createdAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id])

  @@index([messageId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model Group {
  id             String       @id @default(cuid())
  conversationId String       @unique
  name           String
  description    String?
  privacy        GroupPrivacy
  maxMembers     Int?
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relationships
  conversation Conversation   @relation(fields: [conversationId], references: [id])
  creator      User           @relation(fields: [createdBy], references: [id])
  members      GroupMember[]
  channels     GroupChannel[]

  @@index([privacy])
  @@index([createdBy])
}

model GroupMember {
  id        String    @id @default(cuid())
  groupId   String
  userId    String
  role      GroupRole
  joinedAt  DateTime  @default(now())
  invitedBy String?
  isActive  Boolean   @default(true)

  group   Group @relation(fields: [groupId], references: [id])
  user    User  @relation(fields: [userId], references: [id])
  inviter User? @relation("GroupInvites", fields: [invitedBy], references: [id])

  @@unique([groupId, userId])
  @@index([userId])
  @@index([role])
}

model GroupChannel {
  id          String      @id @default(cuid())
  groupId     String
  name        String
  description String?
  channelType ChannelType
  createdBy   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  group   Group @relation(fields: [groupId], references: [id])
  creator User  @relation(fields: [createdBy], references: [id])

  @@index([groupId])
  @@index([channelType])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}

model NotificationSetting {
  id                   String    @id @default(cuid())
  userId               String    @unique
  pushEnabled          Boolean   @default(true)
  soundEnabled         Boolean   @default(true)
  mentionNotifications Boolean   @default(true)
  groupNotifications   Boolean   @default(true)
  messagePreview       Boolean   @default(true)
  emailNotifications   Boolean   @default(true)
  pushNotifications    Boolean   @default(false)
  courseUpdates        Boolean   @default(true)
  newMessages          Boolean   @default(true)
  studyBuddyRequests   Boolean   @default(true)
  marketingEmails      Boolean   @default(false)
  weeklyDigest         Boolean   @default(true)
  quietHoursStart      DateTime?
  quietHoursEnd        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// Messaging System Enums

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  VOICE_NOTE
  SYSTEM
}

enum GroupPrivacy {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum GroupRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum ChannelType {
  TEXT
  ANNOUNCEMENT
  VOICE
}

enum NotificationType {
  MESSAGE
  MENTION
  GROUP_INVITE
  GROUP_JOIN
  REACTION
  SYSTEM
  STUDY_BUDDY_REQUEST
  STUDY_BUDDY_MATCH
  STUDY_SESSION_SCHEDULED
  STUDY_SESSION_REMINDER
  STUDY_SESSION_CANCELLED
  VIDEO_CALL_INCOMING
  VIDEO_CALL_SCHEDULED
}

enum ParticipantRole {
  ADMIN
  MODERATOR
  MEMBER
}

// Instructor Following System
model InstructorFollow {
  id         String   @id @default(cuid())
  userId     String // Student who follows
  creatorId  String // Instructor being followed
  followedAt DateTime @default(now())

  user    User    @relation("UserFollowing", fields: [userId], references: [id])
  creator Creator @relation(fields: [creatorId], references: [id])

  @@unique([userId, creatorId])
  @@index([userId])
  @@index([creatorId])
}

// Meeting Booking System
model Meeting {
  id            String        @id @default(cuid())
  studentId     String // Student who booked
  creatorId     String // Instructor
  title         String
  description   String?
  scheduledAt   DateTime // Meeting time
  duration      Int // Duration in minutes
  meetingType   MeetingType   @default(CONSULTATION)
  status        MeetingStatus @default(SCHEDULED)
  meetingLink   String? // Zoom/Meet link
  price         Float? // Cost of the meeting
  paymentStatus PaymentStatus @default(PENDING)
  cancelReason  String?
  notes         String? // Post-meeting notes
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  student User    @relation("StudentMeetings", fields: [studentId], references: [id])
  creator Creator @relation(fields: [creatorId], references: [id])

  @@index([studentId])
  @@index([creatorId])
  @@index([scheduledAt])
  @@index([status])
}

// Mentor Subscription (OnlyFans-style)
model MentorSubscription {
  id            String             @id @default(cuid())
  studentId     String // Student subscribing
  creatorId     String // Mentor being subscribed to
  tier          SubscriptionTier   @default(BASIC)
  billingPeriod BillingPeriod      @default(MONTHLY)
  price         Float // Monthly or yearly price
  status        SubscriptionStatus @default(ACTIVE)
  startDate     DateTime           @default(now())
  endDate       DateTime // When subscription expires
  autoRenew     Boolean            @default(true)
  paymentStatus PaymentStatus      @default(PENDING)

  // Benefits included
  monthlyMessages Int? // Number of messages per month
  monthlyMeetings Int? // Number of 1-on-1 meetings per month
  meetingDuration Int? // Minutes per meeting
  accessToContent Boolean @default(true) // Access to mentor's exclusive content
  prioritySupport Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User @relation("StudentMentorSubscriptions", fields: [studentId], references: [id])

  @@unique([studentId, creatorId])
  @@index([creatorId])
  @@index([status])
  @@index([endDate])
}

enum SubscriptionTier {
  BASIC // Basic access
  PREMIUM // More meetings + priority support
  VIP // Unlimited access + exclusive perks
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAUSED
  PENDING
}

// Instructor Availability
model InstructorAvailability {
  id          String   @id @default(cuid())
  creatorId   String
  dayOfWeek   Int // 0-6 (Sunday to Saturday)
  startTime   String // HH:MM format
  endTime     String // HH:MM format
  isAvailable Boolean  @default(true)
  timezone    String   @default("UTC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator Creator @relation("CreatorAvailability", fields: [creatorId], references: [id])

  @@index([creatorId])
  @@index([dayOfWeek])
}

enum MeetingType {
  CONSULTATION
  COURSE_HELP
  CAREER_ADVICE
  CODE_REVIEW
  MOCK_INTERVIEW
  MENTORSHIP
}

enum MeetingStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

// Video Call Session Management
model VideoCallSession {
  id             String          @id @default(cuid())
  studySessionId String? // Optional reference to study session
  hostId         String // User who initiated the call
  inviteeId      String // User who was invited
  title          String
  description    String?
  status         VideoCallStatus @default(PENDING)
  sessionToken   String          @unique // Unique token for WebRTC session
  startedAt      DateTime?
  endedAt        DateTime?
  duration       Int? // Duration in seconds
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  host         User              @relation("HostVideoSessions", fields: [hostId], references: [id])
  invitee      User              @relation("InviteeVideoSessions", fields: [inviteeId], references: [id])
  studySession StudySession?     @relation(fields: [studySessionId], references: [id])
  signals      VideoCallSignal[]

  @@index([hostId])
  @@index([inviteeId])
  @@index([status])
  @@index([sessionToken])
}

// Video Call Signaling for WebRTC
model VideoCallSignal {
  id         Int      @id @default(autoincrement())
  sessionId  String // Reference to VideoCallSession.id
  fromUserId String // User sending the signal
  type       String // "offer", "answer", "ice-candidate"
  data       String // JSON stringified WebRTC data
  createdAt  DateTime @default(now())

  session  VideoCallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fromUser User             @relation("VideoCallSignals", fields: [fromUserId], references: [id])

  @@index([sessionId])
  @@index([fromUserId])
  @@index([createdAt])
}

enum VideoCallStatus {
  PENDING
  ACTIVE
  COMPLETED
  DECLINED
  CANCELLED
  FAILED
}

// ============================================
// CREATOR BLUEPRINT MODELS
// ============================================

// Creator Application & Onboarding
model CreatorApplication {
  id               String            @id @default(cuid())
  userId           String            @unique
  status           ApplicationStatus @default(PENDING)
  expertise        String // Field of expertise
  experienceYears  Int? // Years of experience
  sampleContentUrl String? // Link to sample content
  portfolioUrl     String? // Portfolio/website
  socialProof      String? // Testimonials, followers count, etc.
  motivation       String? // Why they want to be a creator
  reviewNotes      String? // Admin review notes
  reviewedAt       DateTime?
  reviewedBy       String? // Admin user ID
  contractSigned   Boolean           @default(false)
  contractSignedAt DateTime?
  kycVerified      Boolean           @default(false)
  kycVerifiedAt    DateTime?
  rejectionReason  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMIT_REQUIRED
}

enum ChannelTier {
  BRONZE
  SILVER
  GOLD
}

// Channel Posts (Category C)
model ChannelPost {
  id           String    @id @default(cuid())
  channelId    String
  title        String? // Optional for backwards compatibility
  titleAr      String?
  content      String
  contentAr    String?
  type         PostType  @default(TEXT)
  mediaUrl     String? // Video, image, or document URL
  thumbnailUrl String?
  duration     Int? // For video posts (in seconds)
  scheduledAt  DateTime? // Schedule for future publish
  publishedAt  DateTime? // Actual publish time
  tier         String    @default("BRONZE") // Minimum tier to access (BRONZE, SILVER, GOLD)
  isPinned     Boolean   @default(false)
  viewCount    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  channel   CreatorChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  likes     PostLike[]
  comments  PostComment[]
  bookmarks PostBookmark[]

  @@index([channelId])
  @@index([publishedAt])
  @@index([tier])
}

enum PostType {
  TEXT
  VIDEO
  IMAGE
  DOCUMENT
  POLL
  ANNOUNCEMENT
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post ChannelPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post ChannelPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User        @relation("PostComments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

model PostBookmark {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post ChannelPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User        @relation("PostBookmarks", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

// Live Sessions (Category C)
model LiveSession {
  id            String            @id @default(cuid())
  channelId     String
  title         String
  titleAr       String?
  description   String?
  descriptionAr String?
  scheduledAt   DateTime
  duration      Int // Duration in minutes
  streamUrl     String? // RTMP/WebRTC URL
  streamKey     String? // Private stream key
  recordingUrl  String? // Recording after session
  status        LiveSessionStatus @default(SCHEDULED)
  maxAttendees  Int? // Max concurrent viewers
  tier          String            @default("BRONZE") // Minimum tier to attend (BRONZE, SILVER, GOLD)
  actualStartAt DateTime?
  actualEndAt   DateTime?
  viewCount     Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  channel   CreatorChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  attendees SessionAttendee[]

  @@index([channelId])
  @@index([scheduledAt])
  @@index([status])
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model SessionAttendee {
  id        String    @id @default(cuid())
  sessionId String
  userId    String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  duration  Int? // Watch time in seconds

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

// Community Resources
model CommunityResource {
  id          String   @id @default(cuid())
  creatorId   String
  title       String
  titleAr     String?
  type        String // PDF, Video, Excel, Template, etc.
  size        String? // File size display
  url         String
  isPinned    Boolean  @default(false)
  downloads   Int      @default(0)
  description String?
  descriptionAr String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([isPinned])
}

// Member Groups (Category C)
model MemberGroup {
  id            String   @id @default(cuid())
  channelId     String
  name          String
  nameAr        String?
  description   String?
  descriptionAr String?
  rules         String?
  rulesAr       String?
  tier          String   @default("BRONZE") // Minimum tier to join (BRONZE, SILVER, GOLD)
  isPrivate     Boolean  @default(false)
  maxMembers    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  channel    CreatorChannel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  members    ChannelGroupMember[]
  posts      GroupPost[]
  moderators GroupModerator[]

  @@index([channelId])
  @@index([tier])
}

model ChannelGroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group MemberGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model GroupModerator {
  id          String   @id @default(cuid())
  groupId     String
  userId      String
  assignedAt  DateTime @default(now())
  permissions Json? // Array of permissions

  group MemberGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
}

model GroupPost {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  content   String
  mediaUrl  String?
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group MemberGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([userId])
  @@index([createdAt])
}

// Course Review System
model CourseReview {
  id               String       @id @default(cuid())
  courseId         String
  reviewerId       String // Admin user ID
  status           ReviewStatus @default(PENDING)
  qualityScore     Int? // 1-10
  contentChecklist Json? // Array of check items
  notes            String?
  rejectionReasons String?
  reviewedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([status])
  @@index([reviewerId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  REQUIRES_CHANGES
}

// Creator Earnings Tracking
model CreatorEarnings {
  id          String      @id @default(cuid())
  creatorId   String
  userId      String? // User who sent tip/payment (optional for anonymous)
  sourceType  EarningType
  sourceId    String? // Course ID, Channel ID, Meeting ID (optional for tips)
  amount      Float
  currency    String      @default("EGP")
  period      String? // e.g., "2025-01" for monthly tracking (optional)
  description String? // Tip message or description
  status      String? // Payment status (PENDING, COMPLETED, FAILED)
  metadata    Json? // Additional data (isAnonymous, message, etc.)
  breakdown   Json? // Detailed metrics (views, completions, etc.)
  createdAt   DateTime    @default(now())

  creator Creator @relation(fields: [creatorId], references: [id])

  @@index([creatorId])
  @@index([userId])
  @@index([period])
  @@index([sourceType])
}

enum EarningType {
  COURSE_ENROLLMENT
  CHANNEL_SUBSCRIPTION
  MEETING_BOOKING
  REVENUE_SHARE
  BONUS
  TIP
}

// Payout System
model CreatorPayout {
  id             String       @id @default(cuid())
  creatorId      String
  amount         Float
  currency       String       @default("EGP")
  status         PayoutStatus @default(PENDING)
  method         PayoutMethod
  accountDetails Json // Bank account or payment method details
  processingFee  Float?
  netAmount      Float?
  requestedAt    DateTime     @default(now())
  processedAt    DateTime?
  processedBy    String? // Admin user ID
  transactionId  String? // External payment reference
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  creator Creator @relation(fields: [creatorId], references: [id])

  @@index([creatorId])
  @@index([status])
  @@index([requestedAt])
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum PayoutMethod {
  BANK_TRANSFER
  PAYPAL
  WALLET
  VODAFONE_CASH
  INSTAPAY
}

// Content Strikes & Warnings
model ContentStrike {
  id           String         @id @default(cuid())
  creatorId    String
  contentType  String // "COURSE", "POST", "LIVE_SESSION"
  contentId    String
  reason       String
  severity     StrikeSeverity
  issuedBy     String // Admin user ID
  issuedAt     DateTime       @default(now())
  expiresAt    DateTime? // Some strikes may expire
  appealStatus AppealStatus?
  appealNotes  String?

  @@index([creatorId])
  @@index([issuedAt])
}

enum StrikeSeverity {
  WARNING
  MINOR
  MAJOR
  CRITICAL
}

enum AppealStatus {
  PENDING
  APPROVED
  REJECTED
}

// Creator Analytics Cache
model CreatorAnalytics {
  id               String   @id @default(cuid())
  creatorId        String
  period           String // e.g., "2025-01-15" for daily, "2025-01" for monthly
  periodType       String // "DAILY", "WEEKLY", "MONTHLY"
  totalRevenue     Float    @default(0)
  totalViews       Int      @default(0)
  totalEnrollments Int      @default(0)
  totalSubscribers Int      @default(0)
  avgCompletion    Float? // Average course completion rate
  avgRating        Float? // Average rating across content
  retentionRate    Float? // Subscriber retention rate
  churnRate        Float? // Subscriber churn rate
  topCourseId      String? // Best performing course
  topChannelId     String? // Best performing channel
  breakdown        Json? // Detailed metrics breakdown
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  creator Creator @relation(fields: [creatorId], references: [id])

  @@unique([creatorId, period, periodType])
  @@index([creatorId])
  @@index([period])
}

// Signature Courses (Category B) Models
model SignatureCourseInvitation {
  id         String    @id @default(cuid())
  creatorId  String    @unique
  invitedBy  String
  message    String
  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?
  status     String    @default("PENDING") // PENDING, ACCEPTED, DECLINED

  creator User @relation(fields: [creatorId], references: [id])

  @@index([creatorId])
  @@index([status])
}

model SignatureCourseProposal {
  id             String    @id @default(cuid())
  courseId       String?   @unique
  creatorId      String
  courseTitle    String
  description    String
  syllabus       String?
  targetAudience String?
  learningGoals  String?
  duration       String?
  pricing        Float?
  cohortSize     Int?      @default(50)
  stage          String    @default("PROPOSAL") // PROPOSAL, SCRIPT_REVIEW, PRODUCTION_REVIEW, APPROVED, REJECTED
  reviewNotes    String?
  reviewedBy     String?
  reviewedAt     DateTime?
  submittedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  course Course? @relation(fields: [courseId], references: [id])

  @@index([creatorId])
  @@index([stage])
}

model SignatureCourseWorkbook {
  id        String   @id @default(cuid())
  courseId  String   @unique
  title     String
  pdfUrl    String?
  content   String? // JSON structure for interactive workbooks
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id])

  @@index([courseId])
}

model SignatureCourseCohort {
  id          String   @id @default(cuid())
  courseId    String
  name        String
  startDate   DateTime
  endDate     DateTime
  maxStudents Int      @default(50)
  currentSize Int      @default(0)
  status      String   @default("UPCOMING") // UPCOMING, ACTIVE, COMPLETED
  meetingLink String?
  schedule    String? // JSON: weekly schedule
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id])

  @@index([courseId])
  @@index([status])
}

model ExpertQASession {
  id            String   @id @default(cuid())
  courseId      String
  expertId      String
  title         String
  description   String?
  scheduledAt   DateTime
  duration      Int      @default(60) // minutes
  meetingLink   String?
  status        String   @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  recordingUrl  String?
  attendeeCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id])

  @@index([courseId])
  @@index([scheduledAt])
}

model CapstoneProject {
  id          String    @id @default(cuid())
  courseId    String
  title       String
  description String
  rubric      String? // JSON: grading rubric
  deadline    DateTime?
  maxScore    Int       @default(100)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  course      Course               @relation(fields: [courseId], references: [id])
  submissions CapstoneSubmission[]

  @@index([courseId])
}

model CapstoneSubmission {
  id            String    @id @default(cuid())
  projectId     String
  userId        String
  submissionUrl String
  description   String?
  score         Float?
  feedback      String?
  status        String    @default("PENDING") // PENDING, GRADED, REQUIRES_REVISION
  submittedAt   DateTime  @default(now())
  gradedAt      DateTime?
  updatedAt     DateTime  @updatedAt

  project CapstoneProject @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@index([status])
}

// User blocking system
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockedUsers", fields: [blockerId], references: [id])
  blocked User @relation("BlockedByUsers", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// Reporting system
model Report {
  id         String   @id @default(cuid())
  reporterId String
  type       String // CONVERSATION, MESSAGE, USER, COURSE, COMMENT, POST
  targetId   String // ID of the reported entity
  reason     String
  status     String   @default("PENDING") // PENDING, UNDER_REVIEW, RESOLVED, DISMISSED
  resolution String? // Admin notes on resolution
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reporter User @relation(fields: [reporterId], references: [id])

  @@index([reporterId])
  @@index([type])
  @@index([status])
  @@index([targetId])
}

// ============================================
// MEMBERSHIP CHANNEL TOOLS
// ============================================

// Membership Tiers for Creator Channels
model MembershipTier {
  id        String         @id @default(cuid())
  channelId String
  channel   CreatorChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  // Tier Details
  name          String
  nameAr        String?
  description   String?
  descriptionAr String?
  price         Float
  currency      String  @default("EGP")
  billingCycle  String  @default("MONTHLY") // MONTHLY, QUARTERLY, YEARLY

  // Features
  features   Json // Array of feature strings
  maxMembers Int? // null = unlimited

  // Content Access Permissions
  hasDiscussionAccess Boolean @default(true)
  hasLiveAccess       Boolean @default(false)
  hasResourceAccess   Boolean @default(false)
  hasPollAccess       Boolean @default(false)
  hasDirectMessaging  Boolean @default(false)

  // Display Settings
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)
  color        String? // Brand color for tier
  icon         String? // Icon/emoji for tier

  // Stats
  subscriberCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions ChannelSubscription[]
  resources     TierResource[]

  @@index([channelId])
  @@index([isActive])
}

// Channel Subscriptions (Enhanced)
model ChannelSubscription {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId String
  channel   CreatorChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  tierId    String
  tier      MembershipTier @relation(fields: [tierId], references: [id])

  // Subscription Details
  status      SubscriptionStatus @default(ACTIVE)
  startedAt   DateTime           @default(now())
  endsAt      DateTime?
  cancelledAt DateTime?
  pausedAt    DateTime?

  // Payment
  priceAtPurchase Float
  paymentMethodId String?
  lastPaymentDate DateTime?
  nextPaymentDate DateTime?

  // Engagement Tracking
  lastActivityAt DateTime @default(now())
  totalMessages  Int      @default(0)
  totalPollVotes Int      @default(0)
  totalDownloads Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, channelId])
  @@index([channelId])
  @@index([userId])
  @@index([tierId])
  @@index([status])
}

// Bulk Messages to Members
model MemberMessage {
  id        String         @id @default(cuid())
  channelId String
  channel   CreatorChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  creatorId String
  creator   Creator        @relation(fields: [creatorId], references: [id])

  // Message Content
  subject   String
  content   String
  contentAr String?

  // Targeting
  targetTierIds  String // Comma-separated tier IDs (empty = all)
  recipientCount Int

  // Stats
  sentCount Int @default(0)
  readCount Int @default(0)

  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([channelId])
  @@index([creatorId])
}

// Polls for Members
model MemberPoll {
  id        String         @id @default(cuid())
  channelId String
  channel   CreatorChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  creatorId String
  creator   Creator        @relation(fields: [creatorId], references: [id])

  // Poll Details
  question   String
  questionAr String?
  options    Json // [{ id, text, textAr, votes: 0 }]

  // Settings
  allowMultiple Boolean @default(false)
  isAnonymous   Boolean @default(true)

  // Targeting
  targetTierIds String // Comma-separated tier IDs

  // Stats
  totalVotes Int @default(0)

  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  votes PollVote[]

  @@index([channelId])
  @@index([creatorId])
}

// Poll Votes
model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  poll      MemberPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionIds String // Comma-separated option IDs
  createdAt DateTime   @default(now())

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([userId])
}

// Tier Resources (Exclusive Content)
model TierResource {
  id     String         @id @default(cuid())
  tierId String
  tier   MembershipTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  // Resource Details
  title         String
  titleAr       String?
  description   String?
  descriptionAr String?
  type          ResourceType
  fileUrl       String
  fileName      String
  fileSize      Int? // bytes

  // Stats
  downloadCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tierId])
}

// ============================================
// VIDEO STREAMING PLATFORM MODELS
// ============================================

// Video Comments with Timestamp Support
model VideoComment {
  id           String     @id @default(cuid())
  videoAssetId String
  videoAsset   VideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Comment content
  content   String
  timestamp Float? // Video timestamp (seconds)

  // Threading
  parentId String?
  parent   VideoComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  VideoComment[] @relation("CommentReplies")

  // Engagement
  likesCount Int @default(0)

  // Status
  isEdited Boolean @default(false)
  isPinned Boolean @default(false)
  isHidden Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes VideoCommentLike[]

  @@index([videoAssetId])
  @@index([userId])
  @@index([parentId])
  @@index([timestamp])
}

// Video Comment Likes
model VideoCommentLike {
  id        String       @id @default(cuid())
  commentId String
  comment   VideoComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

// Video Playlists
model VideoPlaylist {
  id        String  @id @default(cuid())
  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  // Playlist info
  title         String
  titleAr       String?
  description   String?
  descriptionAr String?
  thumbnail     String?

  // Settings
  isPublic  Boolean @default(true)
  isOrdered Boolean @default(true)

  // Stats
  videosCount   Int   @default(0)
  totalDuration Float @default(0) // seconds
  viewsCount    Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items VideoPlaylistItem[]

  @@index([creatorId])
  @@index([isPublic])
}

// Video Playlist Items
model VideoPlaylistItem {
  id           String        @id @default(cuid())
  playlistId   String
  playlist     VideoPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  videoAssetId String
  videoAsset   VideoAsset    @relation("PlaylistItems", fields: [videoAssetId], references: [id], onDelete: Cascade)

  // Ordering
  position Int

  // Optional notes
  notes String?

  addedAt DateTime @default(now())

  @@unique([playlistId, videoAssetId])
  @@index([playlistId, position])
  @@index([videoAssetId])
}

// Video Subtitles/Captions
model VideoSubtitle {
  id           String     @id @default(cuid())
  videoAssetId String
  videoAsset   VideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)

  // Subtitle info
  language String // ISO 639-1 code (en, ar, de, etc.)
  label    String // Display name (English, Arabic, German)
  fileUrl  String // VTT or SRT file URL

  // Settings
  isDefault       Boolean @default(false)
  isAutoGenerated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([videoAssetId, language])
  @@index([videoAssetId])
}

// Video Quality Settings (for adaptive streaming)
model VideoQuality {
  id           String     @id @default(cuid())
  videoAssetId String
  videoAsset   VideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)

  // Quality info
  quality    String // 360p, 480p, 720p, 1080p, 4k
  resolution String // 1920x1080
  bitrate    Int // kbps
  fileSize   Int? // bytes
  url        String // HLS or DASH manifest URL
  codec      String? // h264, h265, vp9

  createdAt DateTime @default(now())

  @@unique([videoAssetId, quality])
  @@index([videoAssetId])
}

// Video Watch History (separate from progress for analytics)
model VideoWatchHistory {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoAssetId String
  videoAsset   VideoAsset @relation("WatchHistory", fields: [videoAssetId], references: [id], onDelete: Cascade)

  // Watch details
  startTime Float   @default(0)
  endTime   Float?
  duration  Float?
  completed Boolean @default(false)

  // Session info
  sessionId  String
  deviceType String? // mobile, tablet, desktop
  browser    String?
  os         String?

  watchedAt DateTime @default(now())

  @@index([userId])
  @@index([videoAssetId])
  @@index([watchedAt])
}

// Video Reactions (like, love, etc.)
model VideoReaction {
  id           String     @id @default(cuid())
  videoAssetId String
  videoAsset   VideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Reaction type
  type VideoReactionType

  createdAt DateTime @default(now())

  @@unique([videoAssetId, userId])
  @@index([videoAssetId])
  @@index([userId])
}

// Video Chapters/Segments
model VideoChapter {
  id           String     @id @default(cuid())
  videoAssetId String
  videoAsset   VideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)

  // Chapter info
  title     String
  titleAr   String?
  startTime Float // seconds
  endTime   Float // seconds
  thumbnail String?

  // Ordering
  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([videoAssetId, position])
}

// System Configuration for storing app-wide settings
model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Creator Withdrawal Requests
model Withdrawal {
  id           String  @id @default(cuid())
  instructorId String
  instructor   Creator @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  amount         Float
  method         String // BANK_TRANSFER, WALLET, PAYPAL
  accountDetails String // JSON string with account info
  status         WithdrawalStatus @default(PENDING)

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  completedAt DateTime?

  notes         String? // Admin notes or rejection reason
  transactionId String? // External transaction ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instructorId])
  @@index([status])
}

// Enums for Video Streaming
enum VideoReactionType {
  LIKE
  LOVE
  INSIGHTFUL
  HELPFUL
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

// ============================================================================
// COHORT-BASED LEARNING SYSTEM
// ============================================================================

// Cohort: Group-based learning with scheduled content and deadlines
model Cohort {
  id            String       @id @default(cuid())
  courseId      String
  name          String
  nameAr        String?
  description   String?
  descriptionAr String?
  startDate     DateTime
  endDate       DateTime
  maxMembers    Int? // Limited seats
  isActive      Boolean      @default(true)
  status        CohortStatus @default(UPCOMING)

  // Pricing (premium feature)
  price    Float?
  currency String? @default("EGP")

  // Schedule
  timezone       String  @default("Africa/Cairo")
  weeklySchedule String? // JSON: days/times for live sessions

  // Requirements
  prerequisites       String? // JSON: required courses/skills
  applicationRequired Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course        Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  members       CohortMember[]
  sessions      CohortSession[]
  announcements CohortAnnouncement[]
  milestones    CohortMilestone[]

  @@index([courseId])
  @@index([status])
  @@index([startDate])
}

// Cohort Member: Student enrollment in a cohort
model CohortMember {
  id       String             @id @default(cuid())
  cohortId String
  userId   String
  status   CohortMemberStatus @default(PENDING)

  // Application
  applicationText String? // Why they want to join
  applicationDate DateTime  @default(now())
  approvedAt      DateTime?
  approvedBy      String? // Admin/Creator user ID

  // Progress
  completedLessons Int   @default(0)
  totalLessons     Int   @default(0)
  progressPercent  Float @default(0)

  // Capstone
  capstoneSubmitted Boolean   @default(false)
  capstoneScore     Float?
  capstoneGradedAt  DateTime?

  // Participation
  attendedSessions Int @default(0)
  missedSessions   Int @default(0)

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cohortId, userId])
  @@index([cohortId])
  @@index([userId])
  @@index([status])
}

// Cohort Session: Live Q&A, office hours, group sessions
model CohortSession {
  id            String            @id @default(cuid())
  cohortId      String
  title         String
  titleAr       String?
  description   String?
  descriptionAr String?
  type          CohortSessionType @default(LIVE_QA)

  scheduledAt DateTime
  duration    Int      @default(60) // minutes

  // Meeting details
  meetingUrl   String? // Zoom, Meet, etc.
  recordingUrl String?

  // Attendance
  maxAttendees  Int?
  attendeeCount Int     @default(0)
  isRecorded    Boolean @default(false)

  status SessionStatus @default(SCHEDULED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cohort    Cohort              @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  attendees SessionAttendance[]

  @@index([cohortId])
  @@index([scheduledAt])
  @@index([status])
}

// Session Attendance: Track who attended cohort sessions
model SessionAttendance {
  id              String    @id @default(cuid())
  sessionId       String
  userId          String
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?
  durationMinutes Int?

  session CohortSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

// Cohort Announcement: Communication to cohort members
model CohortAnnouncement {
  id        String  @id @default(cuid())
  cohortId  String
  title     String
  titleAr   String?
  content   String
  contentAr String?
  isPinned  Boolean @default(false)
  sendEmail Boolean @default(false)

  createdBy String // Creator user ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId])
  @@index([createdAt])
}

// Cohort Milestone: Important deadlines and checkpoints
model CohortMilestone {
  id            String        @id @default(cuid())
  cohortId      String
  title         String
  titleAr       String?
  description   String?
  descriptionAr String?
  dueDate       DateTime
  type          MilestoneType @default(ASSIGNMENT)

  // Optional link to actual assignment/quiz
  relatedId   String? // Assignment or Quiz ID
  relatedType String? // "ASSIGNMENT" or "QUIZ"

  isCompleted     Boolean @default(false)
  completionCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId])
  @@index([dueDate])
}

// Enums for Cohort System
enum CohortStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CohortMemberStatus {
  PENDING // Application pending
  APPROVED // Accepted into cohort
  ACTIVE // Currently participating
  COMPLETED // Finished cohort
  DROPPED // Left cohort
  REJECTED // Application rejected
}

enum CohortSessionType {
  LIVE_QA // Q&A session
  OFFICE_HOURS // One-on-one office hours
  GROUP_WORK // Collaborative work session
  GUEST_SPEAKER // Guest lecture
  REVIEW_SESSION // Exam/project review
  ORIENTATION // Welcome/intro session
}

enum SessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum MilestoneType {
  ASSIGNMENT
  QUIZ
  CAPSTONE
  PEER_REVIEW
  READING
  PROJECT_PHASE
  DEADLINE
}
